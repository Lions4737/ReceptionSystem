      "checkConstraints": {
        "valid_seat": {
          "name": "valid_seat",
          "value": "\"tickets\".\"seat\" IS NULL OR \"tickets\".\"seat\" BETWEEN 1 AND 9"
        },
        "valid_kind": {
          "name": "valid_kind",
          "value": "length(\"tickets\".\"kind\") BETWEEN 1 AND 100"
        },
        "valid_status": {
          "name": "valid_status",
          "value": "\"tickets\".\"status\" IN ('waiting','called','seated','playing','finished','hold','cancelled')"
        },
        "assigned_seat": {
          "name": "assigned_seat",
          "value": "\"tickets\".\"status\" NOT IN ('seated','playing') OR (\"tickets\".\"table_id\" IS NOT NULL AND \"tickets\".\"seat\" IS NOT NULL)"
        },
        "nonnegative_score": {
          "name": "nonnegative_score",
          "value": "\"tickets\".\"final_chips\" IS NULL OR \"tickets\".\"final_chips\" >= 0"
        }
